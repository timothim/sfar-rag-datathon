# ==============================================================================
# RAG-SFAR Configuration (Mac Local & LibreDataHub Production)
# Copy to .env and adjust for LibreDataHub tomorrow!
# ==============================================================================

# --- Paths ---
RAG_SFAR_CORPUS_DIR=data/sfar_recommendations/output
RAG_SFAR_BENCHMARK_PATH=data/antibioprophylaxie_benchmark/datasets/sfar_antibioprophylaxie/benchmark.json
RAG_SFAR_INDEX_DIR=index/sota_bge_m3

# --- LLM Backend (OpenAI-compatible: Ollama, vLLM, Mistral, OpenAI, LiteLLM) ---
# Example for LibreDataHub Ollama:   http://localhost:11434/v1
# Example for LibreDataHub vLLM:     http://vllm:8000/v1
RAG_SFAR_LLM_BASE_URL=http://localhost:11434/v1
RAG_SFAR_LLM_API_KEY=ollama
RAG_SFAR_LLM_MODEL=qwen2.5:14b-instruct
RAG_SFAR_LLM_TEMPERATURE=0.0
RAG_SFAR_LLM_MAX_TOKENS=1024

# --- Embedding Backend ---
# Providers: "sentence_transformer" | "openai_compatible" | "tfidf_svd"
# Recommended on GPU (LibreDataHub): BAAI/bge-m3  or  intfloat/multilingual-e5-large
# Fast on Mac/CPU:                   intfloat/multilingual-e5-small  or  BAAI/bge-m3
RAG_SFAR_EMBEDDING_PROVIDER=sentence_transformer
RAG_SFAR_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_SFAR_EMBEDDING_BASE_URL=
RAG_SFAR_EMBEDDING_API_KEY=

# --- Cross-Encoder Reranker ---
# Providers: "cross_encoder" | "none"
# Recommended on GPU (LibreDataHub): BAAI/bge-reranker-v2-m3
# Fast on Mac/CPU:                   cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RAG_SFAR_RERANKER_PROVIDER=cross_encoder
RAG_SFAR_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# --- Vector Store Backend ---
# Backends: "local" (SQLite + NumPy, zero setup) | "pgvector" (LibreDataHub PostgreSQL)
RAG_SFAR_VECTOR_BACKEND=local
RAG_SFAR_PGVECTOR_DSN=postgresql://postgres:postgres@localhost:5432/sfar_rag

# --- API Server ---
RAG_SFAR_API_HOST=0.0.0.0
RAG_SFAR_API_PORT=8000
