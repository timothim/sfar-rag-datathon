# --- Environnements & caches (à recréer sur LibreDataHub) ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/
*.DS_Store

# --- Secrets ---
.env
.env.*
!.env.example

# --- Artefacts lourds régénérables ---
# Index : à reconstruire sur place (rag-sfar-index), idéalement avec BGE-M3 sur GPU
index/
*.npy
*.pkl
*.sqlite
# Poids de modèles / caches HF / adaptateurs LoRA
models/
checkpoints/
adapters/
*.safetensors
*.gguf
*.bin
.cache/
# Logs et sorties brutes volumineuses
logs/
*.log
runs/
wandb/

# --- Données : uniquement via submodules (data/sfar_recommendations, data/antibioprophylaxie_benchmark) ---
data/*
!data/.gitkeep
!data/sfar_recommendations
!data/antibioprophylaxie_benchmark

# --- Fichiers personnels / pilotage de l'agent IA (ne pas partager) ---
PROMPT*.md
CLAUDE.md
CLAUDE.local.md
AGENTS.md
ag_edits.md
.claude/
COURS_*.pdf
MASTERCLASS_*.md
reports/masterclass_course.html

# Judge verdicts are small JSON evidence files: keep them
!eval_internal/judge/runs/

# Enriched benchmark (third-party, redistribution rights not confirmed): local only.
# Regenerate with: python -m rag_sfar.evaluation.datasets convert-enriched
eval/datasets/abpe171.jsonl
eval/splits/abpe171/
.gpu_lock/
.gpu_queue/
# judge batches of the enriched benchmark contain its question text (local only)
eval_internal/judge/runs/*abpe*/
# blind judge runs mix suites (enriched benchmark included) and their keys stay local
eval_internal/judge/runs/blind_*/
eval_internal/judge/blind_keys/
# merged reports of the enriched benchmark (answers, judge justifications)
reports/eval/judge_v4/**/*abpe*

# Q1 robustness: perturbed copies of the enriched benchmark (its text) and raw result rows stay local
eval_internal/robustness/sets/abpe171/
eval_internal/robustness/results/*.jsonl
eval_internal/robustness/logs/

# work folders holding enriched-benchmark text or held-out drafts: local only
eval_internal/work/x2/
eval_internal/work/q2/
eval_internal/work/genprobe2/

# V1: experts' validated release (sfar-abp-v31.x), converted suites stay local
eval/datasets/abpv*.jsonl
eval/splits/abpv*/
# merged judge reports under the validated grids (answers, judge justifications)
reports/eval/judge_v4/**/*abpv*

# extra GPU lock slots
.gpu_lock_*/

# course material, archived original README and bulky prompt dumps stay local
scripts/build_masterclass_pdf.py
reports/archive/
eval_internal/work/frontier/

# session-specific job queues
scripts/queue_dev_generation.sh
scripts/queue_h_ab.sh

# anticoagulant benchmark supplied by the team on 27/11: local only
eval/datasets/anticoag2026.jsonl
eval/splits/anticoag2026/
reports/eval/*anticoag2026*
# AC1: generated answers and judge outputs on the anticoagulant benchmark (answers, judge justifications): local only
reports/eval/**/*anticoag2026*
reports/eval/judge_v4/*anticoag2026*/
